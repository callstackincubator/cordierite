{
  "name": "@cordierite/react-native",
  "version": "0.4.0-rc.1",
  "description": "Expo native client for Cordierite sessions",
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./build/index.js",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./auto": {
      "types": "./build/auto.d.ts",
      "react-native": "./build/auto.js",
      "import": "./build/auto.js",
      "default": "./build/auto.js"
    },
    "./noop": {
      "types": "./build/noop.d.ts",
      "react-native": "./build/noop.js",
      "import": "./build/noop.js",
      "default": "./build/noop.js"
    },
    "./package.json": "./package.json",
    "./app.plugin.js": "./app.plugin.js"
  },
  "sideEffects": [
    "./build/auto.js"
  ],
  "expo": {
    "plugin": "./app.plugin.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts src/__tests__",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "keywords": [
    "react-native",
    "@cordierite/react-native",
    "cordierite"
  ],
  "repository": "https://github.com/callstackincubator/cordierite",
  "bugs": {
    "url": "https://github.com/callstackincubator/cordierite/issues"
  },
  "author": "Szymon Chmal <szymon@chmal.it> (V3RON)",
  "license": "MIT",
  "homepage": "https://github.com/callstackincubator/cordierite/tree/main/packages/react-native#readme",
  "codegenConfig": {
    "name": "CordieriteSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.callstackincubator.cordierite"
    }
  },
  "dependencies": {
    "@cordierite/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "~19.1.1",
    "@types/react-test-renderer": "19.1.0",
    "@types/node": "^22.10.0",
    "eslint": "^8.57.0",
    "eslint-config-universe": "^15.0.3",
    "expo": "^54.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "expo": ">=54.0.0",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  }
}
